# Generated by meson from doc/Doxyfile.in, do not edit the generated
# copy.  Everything not set here is a doxygen default.
#
# doxygen resolves INPUT and OUTPUT_DIRECTORY against the directory it
# runs in, which is not where this file lives in an out of tree build,
# so meson fills both in with absolute paths.
PROJECT_NAME           = "tarpm"
INPUT                  = @INPUT_DIR@
OUTPUT_DIRECTORY       = @OUTPUT_DIR@
RECURSIVE              = YES

# sphinx reads the XML through breathe.  The HTML is just there to
# look at on its own.
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# meson prints the command it runs, so let doxygen keep quiet
QUIET                  = YES
